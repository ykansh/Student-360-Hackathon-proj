{
  "name": "student-360-extension",
  "displayName": "Student 360",
  "version": "1.0.0",
  "description": "AI study buddy that monitors distraction sites.",
  "author": "Student 360",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@plasmohq/storage": "^1.12.0",
    "@types/chrome": "0.0.269",
    "@types/node": "20.14.9",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "prettier": "3.3.2",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "tabs",
      "webNavigation",
      "activeTab",
      "scripting",
      "offscreen",
      "notifications"
    ],
    "host_permissions": [
      "https://*.instagram.com/*",
      "https://*.youtube.com/*"
    ]
  }
}
